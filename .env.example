# URL absoluta do site, sem barra final. Produção: domínio final (pendente). Homologação: https://hugomartins10s.github.io
SITE_URL=
# Caminho base. Vazio em produção; /site-hugo-martins na homologação do GitHub Pages.
BASE_PATH=
# true na build de homologação: noindex em todas as páginas e robots.txt com Disallow.
HOMOLOGACAO=false
# Webhook do CRM que recebe o formulário de contato (pendente). Vazio = formulário cai para WhatsApp.
FORM_ENDPOINT=
# Chave/ID da ferramenta de analytics sem cookies (pendente).
ANALYTICS_ID=
