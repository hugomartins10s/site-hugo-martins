---
/**
 * Layout base de todas as páginas.
 * - <Head>: title, description, canonical, Open Graph, Twitter (spec 7.1).
 * - JSON-LD: WebSite + Organization (#org) + WebPage + BreadcrumbList em todas as páginas; cada
 *   página acrescenta os nós dela em `schema` (spec 8).
 * - Fundo claro; cada página abre com um <Topo> navy (D23), que recebe a mesma `trilha`. Sem
 *   Topo, o conteúdo ganha o espaço do cabeçalho flutuante.
 * - marca="lumi" aplica a identidade Lumi na página inteira (data-brand no <html>).
 * - noindex: sempre na homologação; em produção, só onde a página pedir (404, styleguide).
 */
import '../styles/tokens.css';
import '../styles/brand-lumi.css';
import '../styles/base.css';
import '../styles/glass.css';
import '../styles/prose.css';
import GlassNav from '../components/glass/GlassNav.astro';
import WhatsAppFab from '../components/glass/WhatsAppFab.astro';
import Footer from '../components/layout/Footer.astro';
import Head from '../components/seo/Head.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { url } from '../lib/links';
import {
  noOrganizacao,
  noPagina,
  noSite,
  noTrilha,
  type ItemTrilha,
  type No,
} from '../lib/schema/grafo';
import { urlAbsolutaDoCaminho, urlInicio } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  marca?: 'hugo' | 'lumi';
  noindex?: boolean;
  /** false só na 404. */
  canonical?: boolean;
  /** Trilha completa (lib/trilha.ts); a mesma vai para o <Topo>. Omitir na Home. */
  trilha?: ItemTrilha[];
  /** Tipo do nó da página no JSON-LD (WebPage, ProfilePage, ContactPage…). */
  tipoPagina?: string;
  /** Nós extras do JSON-LD desta página (Person, Service, BlogPosting…). */
  schema?: No[];
  /** @id da entidade principal da página (mainEntity): #hugo, #livro, #servico… */
  principal?: string;
  tipo?: 'website' | 'article';
  publicado?: string;
  atualizado?: string;
}
const {
  title,
  description,
  marca = 'hugo',
  noindex = false,
  canonical = true,
  trilha = [],
  tipoPagina,
  schema = [],
  principal,
  tipo,
  publicado,
  atualizado,
} = Astro.props;

const inicio = urlInicio(Astro.site);
const urlPagina = urlAbsolutaDoCaminho(Astro.url.pathname, Astro.site);
const temTrilha = trilha.length > 1;
const grafo: No[] = [
  noSite(inicio),
  noOrganizacao(inicio),
  noPagina(inicio, urlPagina, title, description, temTrilha, tipoPagina, principal),
  ...(temTrilha ? [noTrilha(urlPagina, trilha, Astro.site!)] : []),
  ...schema,
];
---

<!doctype html>
<html lang="pt-BR" data-brand={marca === 'lumi' ? 'lumi' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Head
      title={title}
      description={description}
      noindex={noindex}
      canonical={canonical}
      tipo={tipo}
      publicado={publicado}
      atualizado={atualizado}
    />
    <meta name="theme-color" content="#000523" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <!-- Uma fonte crítica pré-carregada: a do título (spec 6.1) -->
    <link
      rel="preload"
      href={url(marca === 'lumi' ? '/fonts/audiowide.woff2' : '/fonts/source-serif-4-var.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Refração (spec 9.3): só Chromium aplica backdrop-filter com filtro SVG. Nos demais fica o
      // vidro normal. Também respeita transparência reduzida, contraste alto e movimento reduzido.
      (function () {
        var d = document.documentElement;
        var p = new URLSearchParams(location.search).get('simular');
        if (p) d.setAttribute('data-simular', p);
        var chromium =
          navigator.userAgentData &&
          navigator.userAgentData.brands.some(function (b) {
            return b.brand === 'Chromium';
          });
        var evitar = matchMedia(
          '(prefers-reduced-transparency: reduce), (prefers-contrast: more), (prefers-reduced-motion: reduce)',
        ).matches;
        if (chromium && !evitar && !p) d.classList.add('lente-ok');
      })();
    </script>
    <JsonLd grafo={grafo} />
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">
      Pular para o conteúdo
    </a>

    <!-- Filtro de refração do vidro: deslocamento suave a partir de ruído de baixa frequência -->
    <svg class="sr-only" aria-hidden="true" focusable="false" width="0" height="0">
      <!-- A região precisa ser absoluta (userSpaceOnUse): com a região relativa padrão, o Chromium
         descarta o backdrop-filter inteiro e mostra o fundo sem desfoque. -->
      <filter
        id="lente"
        filterUnits="userSpaceOnUse"
        x="-50"
        y="-50"
        width="4000"
        height="600"
        color-interpolation-filters="sRGB"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.006 0.012"
          numOctaves="2"
          seed="7"
          result="ruido"
        ></feTurbulence>
        <feGaussianBlur in="ruido" stdDeviation="3" result="ruidoSuave"></feGaussianBlur>
        <feDisplacementMap
          in="SourceGraphic"
          in2="ruidoSuave"
          scale="28"
          xChannelSelector="R"
          yChannelSelector="G"
        ></feDisplacementMap>
      </filter>
    </svg>

    <GlassNav />

    <main id="conteudo" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <slot name="depois" />
    <WhatsAppFab />
  </body>
</html>

<style>
  main {
    padding-bottom: var(--space-8);
  }

  main > :global(:first-child:not(.topo)) {
    margin-top: var(--topo-livre);
  }

  /* Página que termina em navy (só o topo, como a 404, ou a chamada final): o navy encosta no
     rodapé, sem faixa clara no meio. */
  main:has(> :global(:is(.topo, .cta-final):last-child)) {
    padding-bottom: 0;
  }

  main:focus {
    outline: none;
  }
</style>
