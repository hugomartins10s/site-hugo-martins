---
/**
 * Home (spec 5.1). Seções, na ordem da spec: hero · as duas frentes · a esteira · Lumi · quem é o
 * Hugo · Método (4 conceitos) · livro · últimos 3 posts · contato rápido.
 * - Slogan "A Perspectiva que mudará a sua Atitude" fica fora até a P33 (só aparece na página
 *   Holos do manual); entra sozinho quando `slogan` existir em empresa.json.
 * - Método: os 4 primeiros conceitos do lote 1, na ordem da spec 4.4. Últimos posts: só com posts.
 */
import Base from '../layouts/Base.astro';
import Topo from '../components/layout/Topo.astro';
import Lead from '../components/conteudo/Lead.astro';
import Card from '../components/conteudo/Card.astro';
import EsteiraDiagram from '../components/conteudo/EsteiraDiagram.astro';
import GlassButton from '../components/glass/GlassButton.astro';
import Frentes from '../components/pagina/Frentes.astro';
import ProdutoCards from '../components/pagina/ProdutoCards.astro';
import CtaFinal from '../components/pagina/CtaFinal.astro';
import { empresa } from '../lib/empresa';
import { url } from '../lib/links';
import { pagina, tituloSeo } from '../lib/paginas';
import { produtosDaFrente } from '../lib/produtos';
import { dataCurta } from '../lib/datas';
import { caminhoDoConceito, conceitosOrdenados } from '../lib/conceitos';
import { caminhoDoPost, postsOrdenados } from '../lib/posts';

const p = await pagina('inicio');
const livroPagina = await pagina('livro');
const { pessoa, livro } = empresa;
const treinamentos = await produtosDaFrente('empresas');
const conceitos = (await conceitosOrdenados()).filter((c) => c.data.lote === 1).slice(0, 4);
const posts = (await postsOrdenados()).slice(0, 3);
const lista = (xs: string[]) => `${xs.slice(0, -1).join(', ')} e ${xs.at(-1)}`;
---

<Base title={tituloSeo(p)} description={p.data.resumo}>
  <Topo class="inicio__topo">
    <span class="eyebrow">{pessoa.atuacao}</span>
    <h1 class="display">{p.data.titulo}</h1>
    {empresa.slogan && <p class="inicio__slogan">{empresa.slogan}</p>}
    <div class="inicio__hero-base">
      <div>
        <Lead>{p.data.resumo}</Lead>
        <div class="acoes">
          <GlassButton href={url('/para-voce/')} tamanho="grande">
            Para você
          </GlassButton>
          <GlassButton href={url('/para-empresas/')} variante="secundario" tamanho="grande">
            Para empresas
          </GlassButton>
        </div>
      </div>
      <dl class="inicio__ficha">
        <div>
          <dt>Criou</dt>
          {pessoa.criacoes.map((c) => (
            <dd>{c}</dd>
          ))}
        </div>
        <div>
          <dt>Livro</dt>
          <dd>
            <a href={url(livro.caminho)}>{livro.titulo}</a>
          </dd>
        </div>
      </dl>
    </div>
  </Topo>

  <section class="container secao" aria-labelledby="frentes">
    <div class="secao__cabeca">
      <span class="eyebrow">Desenvolvimento de Potencial Humano</span>
      <h2 id="frentes">Duas frentes de trabalho</h2>
    </div>
    <Frentes />
  </section>

  <section class="faixa secao" aria-labelledby="esteira">
    <div class="container">
      <div class="secao__cabeca">
        <span class="eyebrow">Para você</span>
        <h2 id="esteira">A esteira do trabalho individual</h2>
      </div>
      <EsteiraDiagram />
      <p class="secao__pe">
        <a class="link-seta" href={url('/para-voce/')}>
          Como funciona o trabalho individual com Hugo Martins
        </a>
      </p>
    </div>
  </section>

  <section class="secao inicio__lumi" data-brand="lumi" aria-labelledby="lumi">
    <div class="container">
      <div class="secao__cabeca">
        <img
          class="inicio__lumi-logo"
          src={url('/brand/lumi.svg')}
          width="2777"
          height="979"
          alt=""
          loading="lazy"
        />
        <h2 id="lumi">Treinamentos para empresas: {empresa.marcas.empresas.nome}</h2>
      </div>
      <ProdutoCards produtos={treinamentos} eyebrow={() => 'Treinamento'} />
      <p class="secao__pe">
        <a class="link-seta" href={url('/para-empresas/')}>
          O que é a Lumi – Soluções Integradas
        </a>
      </p>
    </div>
  </section>

  <section class="faixa secao" aria-labelledby="hugo">
    <div class="container inicio__hugo">
      <div>
        <span class="eyebrow">{pessoa.atuacao}</span>
        <h2 id="hugo">Quem é Hugo Martins</h2>
      </div>
      <div class="inicio__hugo-texto">
        <p class="inicio__hugo-destaque">{pessoa.descricao}</p>
        <p>
          Começou pelo {pessoa.comecouPor} e criou {lista(pessoa.criacoes.map((c) => `o ${c}`))}.
        </p>
        <p class="secao__pe">
          <a class="link-seta" href={url('/hugo-martins/')}>
            Quem é Hugo Martins: história, método e livro
          </a>
        </p>
      </div>
    </div>
  </section>

  {conceitos.length > 0 && (
    <section class="container secao" aria-labelledby="metodo">
      <div class="secao__cabeca">
        <span class="eyebrow">Método</span>
        <h2 id="metodo">O método de Hugo Martins</h2>
      </div>
      <div class="grade">
        {conceitos.map((c) => (
          <Card titulo={c.data.titulo} href={url(caminhoDoConceito(c))}>
            <p>{c.data.pergunta}</p>
          </Card>
        ))}
      </div>
      <p class="secao__pe">
        <a class="link-seta" href={url('/metodo/')}>
          Todos os conceitos do método
        </a>
      </p>
    </section>
  )}

  <section class="container inicio__livro-secao" aria-labelledby="livro">
    <div class="inicio__livro tema-navy">
      <div>
        <span class="eyebrow">O livro</span>
        <h2 id="livro">
          <a href={url(livro.caminho)}>{livro.titulo}</a>
        </h2>
        <p>{livroPagina.data.resumo}</p>
      </div>
      <dl class="inicio__livro-ficha">
        <div>
          <dt>Autor</dt>
          <dd>{pessoa.nome}</dd>
        </div>
        <div>
          <dt>Editora</dt>
          <dd>{livro.editora}</dd>
        </div>
        <div>
          <dt>e-ISBN</dt>
          <dd>{livro.isbnEbook}</dd>
        </div>
      </dl>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="faixa secao" aria-labelledby="blog">
      <div class="container">
        <div class="secao__cabeca">
          <span class="eyebrow">Blog</span>
          <h2 id="blog">Do blog</h2>
        </div>
        <div class="grade">
          {posts.map((post) => (
            <Card
              titulo={post.data.titulo}
              href={url(caminhoDoPost(post))}
              meta={`Publicado em ${dataCurta(post.data.publicado)}`}
            />
          ))}
        </div>
        <p class="secao__pe">
          <a class="link-seta" href={url('/blog/')}>
            Todos os textos do blog
          </a>
        </p>
      </div>
    </section>
  )}

  <CtaFinal titulo="Falar com o Hugo">
    <p>
      E-mail: <a href={`mailto:${empresa.contato.email}`}>{empresa.contato.email}</a>
    </p>
  </CtaFinal>
</Base>

<style>
  .inicio__slogan {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--text-strong);
  }

  :global(.tema-navy.topo.inicio__topo) {
    padding-top: calc(var(--topo-livre) + var(--space-4));
  }

  :global(.inicio__topo) .display {
    max-width: 19ch;
    margin-bottom: var(--space-6);
  }

  .inicio__hero-base {
    display: grid;
    gap: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .inicio__hero-base .acoes {
    margin-top: var(--space-6);
  }

  .inicio__ficha {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    align-content: start;
  }

  .inicio__ficha dt {
    margin-bottom: var(--space-2);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .inicio__ficha dd {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--text-strong);
  }

  .inicio__ficha dd a {
    color: inherit;
    text-decoration-color: var(--line-strong);
  }

  @media (min-width: 60rem) {
    .inicio__hero-base {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
      gap: var(--space-8);
    }

    .inicio__ficha {
      padding-left: var(--space-6);
      border-left: 1px solid var(--line);
    }
  }

  .inicio__lumi-logo {
    width: min(100%, 180px);
    height: auto;
  }

  .inicio__lumi .secao__cabeca h2 {
    max-width: 24ch;
  }

  .inicio__hugo {
    display: grid;
    gap: var(--space-5) var(--space-8);
  }

  @media (min-width: 60rem) {
    .inicio__hugo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }
  }

  .inicio__hugo-texto p {
    max-width: var(--measure);
  }

  .inicio__hugo-destaque {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--text-strong);
  }

  .inicio__livro-secao {
    padding-bottom: var(--space-9);
  }

  .inicio__livro {
    display: grid;
    gap: var(--space-6) var(--space-8);
    padding: clamp(var(--space-6), 5vw, var(--space-8));
    border-radius: 28px;
    background: radial-gradient(90% 120% at 100% 0%, #0d1540 0%, transparent 60%), var(--bg);
    color: var(--text);
  }

  @media (min-width: 60rem) {
    .inicio__livro {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .inicio__livro h2 a {
    color: var(--text-strong);
    text-decoration: none;
  }

  .inicio__livro h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .inicio__livro p {
    max-width: var(--measure);
    margin: 0;
  }

  .inicio__livro-ficha {
    gap: 0;
    margin: 0;
  }

  .inicio__livro-ficha div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .inicio__livro-ficha dt {
    font-weight: 400;
    color: var(--text-muted);
  }

  .inicio__livro-ficha dd {
    text-align: right;
    color: var(--text-strong);
  }
</style>
