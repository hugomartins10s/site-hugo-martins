---
// Home provisória: título e parágrafo-resposta são os rascunhos da spec 5.1, palavra por palavra.
// A Home completa entra na fase 3.
import Base from '../layouts/Base.astro';
import Lead from '../components/conteudo/Lead.astro';

const titulo = 'Hugo Martins · Desenvolvimento de Potencial Humano | 10S';
const resumo =
  'Hugo Martins é terapeuta e formador, criador do 10S e do Reiki da Alma. Seu trabalho, o Desenvolvimento de Potencial Humano, tem duas frentes: para pessoas, uma esteira que começa obrigatoriamente pelo 10S e segue para o Potencial Humano ou o Potencial Corporativo; para empresas, os treinamentos da Lumi – Soluções Integradas.';
---

<Base title={titulo} description={resumo}>
  <div class="container">
    <h1 class="display">Hugo Martins – Desenvolvimento de Potencial Humano</h1>
    <Lead>{resumo}</Lead>
  </div>
</Base>
