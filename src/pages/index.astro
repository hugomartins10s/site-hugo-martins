---
/**
 * Home. Mostra autoridade e curiosidade, não explicação (D52, desvio pedido da spec 5.1):
 * hero com a frase do Hugo · o que ele ajuda a resolver, na vida e na empresa · quem é o Hugo ·
 * Método (só a cadeia do destino, D57) · livro · últimos posts · em resumo · contato.
 * - Quem compra, a esteira e os formatos saem da Home e ficam em /para-voce/ e /para-empresas/.
 * - O parágrafo-resposta da spec continua no HTML, discreto, no fim ("Em resumo"), e na meta
 *   description.
 * - Slogan "A Perspectiva que mudará a sua Atitude" fica fora até a P33; entra sozinho quando
 *   `slogan` existir em empresa.json.
 * - Chamadas (D51): frases-assinatura do Hugo (lib/frases.ts). Problemas (D52): lib/problemas.ts.
 */
import Base from '../layouts/Base.astro';
import Topo from '../components/layout/Topo.astro';
import Lead from '../components/conteudo/Lead.astro';
import Card from '../components/conteudo/Card.astro';
import GlassButton from '../components/glass/GlassButton.astro';
import CtaFinal from '../components/pagina/CtaFinal.astro';
import FraseHugo from '../components/conteudo/FraseHugo.astro';
import CadeiaDestino from '../components/conteudo/CadeiaDestino.astro';
import { frases } from '../lib/frases';
import { naEmpresa, naVida } from '../lib/problemas';
import { empresa } from '../lib/empresa';
import { url } from '../lib/links';
import { pagina, tituloSeo } from '../lib/paginas';
import { dataCurta } from '../lib/datas';
import { caminhoDoPost, postsOrdenados } from '../lib/posts';

const p = await pagina('inicio');
const livroPagina = await pagina('livro');
const { pessoa, livro } = empresa;
const posts = (await postsOrdenados()).slice(0, 3);
const lista = (xs: string[]) => `${xs.slice(0, -1).join(', ')} e ${xs.at(-1)}`;

/** Os nomes dos programas, só como convite: o que cada um é, a página dele explica. */
const caminhos = [
  { nome: '10S', href: '/para-voce/10s/' },
  { nome: 'Potencial Humano', href: '/para-voce/potencial-humano/' },
  { nome: 'Potencial Corporativo', href: '/para-voce/potencial-corporativo/' },
];
---

<Base title={tituloSeo(p)} description={p.data.resumo}>
  <Topo class="inicio__topo">
    <div class="inicio__hero">
      <div class="inicio__texto">
        <h1 class="inicio__h1">{p.data.titulo}</h1>
        <p class="display inicio__frase">
          {frases.almaCorpo.texto
            .split(/(?<=,) /)
            .map((parte, i) => (i > 0 ? [' ', <span>{parte}</span>] : <span>{parte}</span>))}
        </p>
        {empresa.slogan && <p class="inicio__slogan">{empresa.slogan}</p>}
        <div class="inicio__hero-base">
          <Lead>{pessoa.descricao}</Lead>
          <div class="acoes">
            <GlassButton href={url('/hugo-martins/')} tamanho="grande">
              Conhecer Hugo Martins
            </GlassButton>
            <GlassButton href={url('/contato/')} variante="secundario" tamanho="grande">
              Falar com o Hugo
            </GlassButton>
          </div>
        </div>
      </div>
      {/* Foto do Hugo com as três sombras (D54): sem o fundo branco, apoiada na borda de baixo. */}
      <div class="inicio__foto">
        <img
          src={url('/img/hugo-martins-hero.webp')}
          srcset={`${url('/img/hugo-martins-hero-480.webp')} 480w, ${url('/img/hugo-martins-hero.webp')} 727w`}
          sizes="(min-width: 60rem) 36vw, 86vw"
          width="727"
          height="748"
          alt="Hugo Martins sorrindo, de blazer caramelo e camisa azul, com três sombras de pessoas atrás dele"
          fetchpriority="high"
        />
      </div>
    </div>
  </Topo>

  <section class="container secao" aria-labelledby="resolve">
    <div class="secao__cabeca">
      <h2 id="resolve">O que Hugo Martins ajuda a resolver</h2>
    </div>
    <div class="resolve">
      <div class="resolve__coluna">
        <h3 class="resolve__onde">Na sua vida</h3>
        <ol class="resolve__lista">
          {naVida.map((x) => (
            <li>
              <span class="resolve__titulo">{x.titulo}</span>
              <span class="resolve__texto">{x.texto}</span>
            </li>
          ))}
        </ol>
        <p class="resolve__caminhos">
          {caminhos.map((c) => (
            <a class="link-seta" href={url(c.href)}>
              {c.nome}
            </a>
          ))}
        </p>
      </div>
      <div class="resolve__coluna resolve__coluna--lumi" data-brand="lumi">
        <h3 class="resolve__onde">Na sua empresa</h3>
        <ol class="resolve__lista">
          {naEmpresa.map((x) => (
            <li>
              <span class="resolve__titulo">{x.titulo}</span>
              <span class="resolve__texto">{x.texto}</span>
            </li>
          ))}
        </ol>
        <p class="resolve__caminhos">
          <a class="resolve__lumi" href={url('/para-empresas/')}>
            <img src={url('/brand/lumi.svg')} width="2777" height="979" alt="" loading="lazy" />
            <span class="link-seta">{empresa.marcas.empresas.nome}</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="secao tema-navy navy-profundo inicio__voz" aria-labelledby="hugo">
    <div class="container">
      <FraseHugo frase={frases.biologia} />
    </div>
    <div class="container inicio__hugo">
      <div>
        <span class="eyebrow">{pessoa.atuacao}</span>
        <h2 id="hugo">Quem é Hugo Martins</h2>
      </div>
      <div class="inicio__hugo-texto">
        <p class="inicio__hugo-destaque">
          Começou pelo {pessoa.comecouPor} e criou {lista(pessoa.criacoes.map((c) => `o ${c}`))}.
        </p>
        <p>
          Autor do livro <a href={url(livro.caminho)}>{livro.titulo}</a>.
        </p>
        <p class="secao__pe">
          <a class="link-seta" href={url('/hugo-martins/')}>
            Quem é Hugo Martins: história, método e livro
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="container secao" aria-labelledby="metodo">
    <div class="secao__cabeca">
      <span class="eyebrow">Método</span>
      <h2 id="metodo">O método de Hugo Martins</h2>
    </div>
    <div class="inicio__cadeia">
      <CadeiaDestino />
    </div>
    <p class="secao__pe">
      <a class="link-seta" href={url('/metodo/')}>
        Conhecer o método
      </a>
    </p>
  </section>

  <section class="container inicio__livro-secao" aria-labelledby="livro">
    <div class="inicio__livro tema-navy">
      <img
        class="inicio__livro-capa"
        src={url('/img/livro-reiki-uma-viagem-a-alma-400.webp')}
        srcset={`${url('/img/livro-reiki-uma-viagem-a-alma-400.webp')} 400w, ${url('/img/livro-reiki-uma-viagem-a-alma.webp')} 931w`}
        sizes="(min-width: 60rem) 13rem, 11rem"
        width="400"
        height="577"
        alt="Capa do livro Reiki, uma Viagem à Alma, de Hugo David Santos Martins, publicado pela Editora Viseu"
        loading="lazy"
      />
      <div>
        <span class="eyebrow">O livro</span>
        <h2 id="livro">
          <a href={url(livro.caminho)}>{livro.titulo}</a>
        </h2>
        <p>{livroPagina.data.resumo}</p>
        {livroPagina.data.lojas[0] && (
          <div class="acoes">
            <GlassButton href={livroPagina.data.lojas[0].url} rel="noopener" target="_blank">
              Comprar na {livroPagina.data.lojas[0].nome}
            </GlassButton>
          </div>
        )}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="faixa secao" aria-labelledby="blog">
      <div class="container">
        <div class="secao__cabeca">
          <span class="eyebrow">Blog</span>
          <h2 id="blog">Do blog</h2>
        </div>
        <div class="grade">
          {posts.map((post) => (
            <Card
              titulo={post.data.titulo}
              href={url(caminhoDoPost(post))}
              meta={`Publicado em ${dataCurta(post.data.publicado)}`}
            />
          ))}
        </div>
        <p class="secao__pe">
          <a class="link-seta" href={url('/blog/')}>
            Todos os textos do blog
          </a>
        </p>
      </div>
    </section>
  )}

  <section class="container inicio__resumo" aria-labelledby="resumo">
    <h2 id="resumo" class="eyebrow">
      Em resumo
    </h2>
    <p>{p.data.resumo}</p>
  </section>

  <CtaFinal titulo="Falar com o Hugo">
    <p>
      E-mail: <a href={`mailto:${empresa.contato.email}`}>{empresa.contato.email}</a>
    </p>
  </CtaFinal>
</Base>

<style>
  .inicio__slogan {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--text-strong);
  }

  /* O topo da Home termina na foto: sem respiro embaixo, a foto encosta na borda (D54). */
  :global(.tema-navy.topo.inicio__topo) {
    padding-top: calc(var(--topo-livre) + var(--space-4));
    padding-bottom: 0;
    overflow: hidden;
  }

  .inicio__hero {
    display: grid;
    gap: var(--space-6);
  }

  .inicio__texto {
    align-self: center;
  }

  .inicio__foto {
    position: relative;
    justify-self: center;
    align-self: end;
    width: min(86vw, 26rem);
  }

  /* Luz azul atrás do Hugo: é ela que deixa as sombras da foto visíveis sobre o navy (D54). */
  .inicio__foto::before {
    content: '';
    position: absolute;
    inset: 0 -18% -4%;
    background: radial-gradient(50% 55% at 50% 62%, #1f3a6b, rgb(31 58 107 / 0) 100%);
  }

  .inicio__foto img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 60rem) {
    .inicio__hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-7);
    }

    .inicio__texto {
      padding-bottom: clamp(var(--space-7), 4vw, var(--space-8));
    }

    .inicio__foto {
      justify-self: end;
      width: min(100%, 30rem);
    }
  }

  .inicio__h1 {
    margin-bottom: var(--space-5);
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--text);
  }

  /* Cada metade da frase numa linha ("A Alma fala, / o Corpo traduz!"), quando couber. */
  .inicio__frase span {
    display: inline-block;
  }

  .inicio__frase {
    font-size: var(--step-5);
    margin-top: 0;
    line-height: 1.05;
    font-family: var(--font-h1);
    font-weight: 400;
    letter-spacing: var(--tracking-display);
    max-width: none;
    margin-bottom: var(--space-6);
    color: var(--text-strong);
    text-wrap: balance;
  }

  /* Autoridade em uma linha, sem explicar o trabalho (D52). */
  .inicio__hero-base {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  /* Os textos do hero usam a largura toda da coluna (pedido do Jonathan). */
  .inicio__hero-base :global(.lead) {
    max-width: none;
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text);
  }

  .inicio__hero-base .acoes {
    margin: 0;
  }

  /* O que ele ajuda a resolver: na vida e na empresa, lado a lado. */
  .resolve {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 60rem) {
    .resolve {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-9);
    }

    .resolve__coluna--lumi {
      padding-left: var(--space-8);
      border-left: 1px solid var(--line);
    }
  }

  .resolve__onde {
    margin: 0 0 var(--space-4);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .resolve__lista {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: resolve;
  }

  .resolve__lista li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
    counter-increment: resolve;
  }

  .resolve__lista li::before {
    content: counter(resolve, decimal-leading-zero);
    grid-row: 1 / span 2;
    padding-top: 0.45em;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--brand-2);
  }

  .resolve__titulo {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }

  .resolve__texto {
    max-width: 44ch;
    color: var(--text-muted);
  }

  .resolve__caminhos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-6);
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .resolve__lumi {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    text-decoration: none;
  }

  .resolve__lumi img {
    width: 112px;
    height: auto;
  }

  .inicio__resumo {
    padding-bottom: var(--space-8);
  }

  .inicio__resumo h2 {
    margin-bottom: var(--space-3);
  }

  .inicio__resumo p {
    max-width: var(--measure);
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .inicio__cadeia {
    margin-bottom: var(--space-5);
  }

  .inicio__hugo {
    display: grid;
    gap: var(--space-5) var(--space-8);
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 60rem) {
    .inicio__hugo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }
  }

  .inicio__hugo-texto p {
    max-width: var(--measure);
  }

  .inicio__hugo-destaque {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--text-strong);
  }

  .inicio__livro-secao {
    padding-bottom: var(--space-9);
  }

  .inicio__livro {
    display: grid;
    gap: var(--space-6) var(--space-8);
    padding: clamp(var(--space-6), 5vw, var(--space-8));
    border-radius: 28px;
    background: radial-gradient(90% 120% at 100% 0%, #0d1540 0%, transparent 60%), var(--bg);
    color: var(--text);
  }

  /* Capa do livro (D55): no celular, em cima; no desktop, à esquerda do texto. */
  .inicio__livro-capa {
    width: 11rem;
    height: auto;
    filter: drop-shadow(0 18px 28px rgb(0 0 0 / 0.45));
  }

  @media (min-width: 60rem) {
    .inicio__livro {
      grid-template-columns: 13rem minmax(0, 1fr);
      align-items: center;
    }

    .inicio__livro-capa {
      width: 100%;
    }
  }

  .inicio__livro h2 a {
    color: var(--text-strong);
    text-decoration: none;
  }

  .inicio__livro h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .inicio__livro p {
    max-width: var(--measure);
    margin: 0;
  }
</style>
