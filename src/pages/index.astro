---
// Home provisória da fase 0: título e parágrafo-resposta são os rascunhos da spec 5.1, palavra por palavra.
import Base from '../layouts/Base.astro';

const titulo = 'Hugo Martins · Desenvolvimento de Potencial Humano | 10S';
const resumo =
