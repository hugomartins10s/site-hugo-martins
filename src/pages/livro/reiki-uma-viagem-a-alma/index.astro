---
/**
 * Livro (spec 3.3 e 5.8): ficha, sinopse própria (P26) e onde comprar (só links verificados, P21).
 * Os direitos de edição são da editora: nenhum trecho do livro. O enredo não é biografia do Hugo.
 * JSON-LD: Book (#livro), autor #hugo.
 */
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Topo from '../../../components/layout/Topo.astro';
import Lead from '../../../components/conteudo/Lead.astro';
import FactList from '../../../components/conteudo/FactList.astro';
import Atualizado from '../../../components/conteudo/Atualizado.astro';
import CtaFinal from '../../../components/pagina/CtaFinal.astro';
import GlassButton from '../../../components/glass/GlassButton.astro';
import { empresa } from '../../../lib/empresa';
import { url } from '../../../lib/links';
import { trilha } from '../../../lib/trilha';
import { caminhoDoConceito } from '../../../lib/conceitos';
import { pagina, tituloSeo } from '../../../lib/paginas';
import { ids, noLivro } from '../../../lib/schema/grafo';
import { urlAbsolutaDoCaminho, urlInicio } from '../../../lib/seo';

const p = await pagina('livro');
const { Content } = await render(p);
// Relação do livro com o Reiki da Alma (spec 5.8): link para o conceito, quando a página existir.
const reiki = await getEntry('conceitos', 'reiki-da-alma');
const caminho = trilha(['Livro', empresa.livro.caminho]);
const inicio = urlInicio(Astro.site);
const urlPagina = urlAbsolutaDoCaminho(Astro.url.pathname, Astro.site);
---

<Base
  title={tituloSeo(p)}
  description={p.data.resumo}
  trilha={caminho}
  schema={[noLivro(inicio, urlPagina, p.data.resumo)]}
  principal={ids(inicio).livro}
>
  <Topo trilha={caminho} class="livro__topo">
    <span class="eyebrow">O livro de Hugo Martins</span>
    <h1 class="display">{p.data.titulo}</h1>
    <Lead>{p.data.resumo}</Lead>
    {p.data.lojas[0] && (
      <div class="acoes">
        <GlassButton href={p.data.lojas[0].url} tamanho="grande" rel="noopener" target="_blank">
          Comprar na {p.data.lojas[0].nome}
        </GlassButton>
      </div>
    )}
    <img
      class="livro__capa"
      src={url('/img/livro-reiki-uma-viagem-a-alma.webp')}
      srcset={`${url('/img/livro-reiki-uma-viagem-a-alma-400.webp')} 400w, ${url('/img/livro-reiki-uma-viagem-a-alma.webp')} 931w`}
      sizes="(min-width: 60rem) 18rem, 12rem"
      width="931"
      height="1342"
      alt="Capa do livro Reiki, uma Viagem à Alma, de Hugo David Santos Martins, publicado pela Editora Viseu"
      fetchpriority="high"
    />
  </Topo>

  <div class="container secao livro">
    <FactList titulo="Ficha" fatos={p.data.fatos} />
    <p class="livro__autor">
      Sobre o autor: <a href={url('/hugo-martins/')}>quem é Hugo Martins</a>.
    </p>
    <div class="prose">
      <Content />
    </div>
    {reiki && (
      <p class="livro__autor">
        No método: <a href={url(caminhoDoConceito(reiki))}>o que é o Reiki da Alma</a>.
      </p>
    )}

    {p.data.lojas.length > 0 && (
      <section class="prose" aria-labelledby="lojas">
        <h2 id="lojas">Onde comprar</h2>
        <ul>
          {p.data.lojas.map((l) => (
            <li>
              <a href={l.url} rel="noopener" target="_blank">
                {l.nome}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <Atualizado data={p.data.atualizado} />
  </div>

  <CtaFinal />
</Base>

<style>
  /* Capa do livro no topo (D55): à direita do texto no desktop, embaixo no celular. */
  :global(.livro__topo .topo__conteudo) {
    display: grid;
    column-gap: var(--space-8);
  }

  .livro__capa {
    width: 12rem;
    height: auto;
    margin-top: var(--space-6);
    filter: drop-shadow(0 18px 28px rgb(0 0 0 / 0.45));
  }

  @media (min-width: 60rem) {
    :global(.livro__topo .topo__conteudo) {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: center;
    }

    :global(.livro__topo .topo__conteudo) > :global(*) {
      grid-column: 1;
    }

    :global(.livro__topo .topo__conteudo) > .livro__capa {
      grid-column: 2;
      grid-row: 1 / span 5;
      width: 100%;
      margin-top: 0;
    }
  }

  .livro {
    display: grid;
    gap: var(--space-7);
  }

  .livro > :global(*) {
    margin: 0;
  }
</style>
