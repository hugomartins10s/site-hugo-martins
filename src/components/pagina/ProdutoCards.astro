---
// Grade de cartões de produto (hubs, Home e "outras etapas"). O texto do cartão é a `chamada`
// [C] da spec 3.1; sem ela (treinamentos da Lumi), a pergunta-alvo da página.
import Card from '../conteudo/Card.astro';
import { url } from '../../lib/links';
import { caminhoDoProduto, type Produto } from '../../lib/produtos';

interface Props {
  produtos: Produto[];
  eyebrow?: (p: Produto) => string | undefined;
  nivel?: 2 | 3 | 4;
}
const { produtos, eyebrow, nivel = 3 } = Astro.props;
---

<div class="grade">
  {produtos.map((p) => (
    <Card
      titulo={p.data.titulo}
      href={url(caminhoDoProduto(p))}
      eyebrow={eyebrow?.(p)}
      nivel={nivel}
    >
      <p>{p.data.chamada ?? p.data.pergunta}</p>
    </Card>
  ))}
</div>
