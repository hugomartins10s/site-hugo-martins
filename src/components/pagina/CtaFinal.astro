---
/**
 * Chamada final da página (spec 5, item 7): título curto e botões para o contato e o WhatsApp.
 * Fica numa faixa navy, como o topo. Sem texto de venda: só a ação.
 */
import GlassButton from '../glass/GlassButton.astro';
import WhatsApp from '../icones/WhatsApp.astro';
import { linkWhatsApp } from '../../lib/empresa';
import { url } from '../../lib/links';

interface Props {
  titulo?: string;
  rotulo?: string;
  href?: string;
}
const {
  titulo = 'Falar com o Hugo',
  rotulo = 'Falar com o Hugo',
  href = '/contato/',
} = Astro.props;
---

<section class="cta-final tema-navy navy-profundo" aria-labelledby="cta-final">
  <div class="container cta-final__conteudo">
    <div class="cta-final__texto">
      <h2 id="cta-final">{titulo}</h2>
      <slot />
    </div>
    <div class="acoes">
      <GlassButton href={url(href)} tamanho="grande">
        {rotulo}
      </GlassButton>
      <GlassButton
        href={linkWhatsApp()}
        variante="secundario"
        tamanho="grande"
        rel="noopener"
        target="_blank"
      >
        <WhatsApp tamanho={20} />
        WhatsApp
      </GlassButton>
    </div>
  </div>
</section>

<style>
  .cta-final {
    padding-block: var(--space-9);
  }

  .cta-final__conteudo {
    display: grid;
    gap: var(--space-6) var(--space-8);
    align-items: end;
  }

  @media (min-width: 60rem) {
    .cta-final__conteudo {
      grid-template-columns: minmax(0, 1.4fr) auto;
    }
  }

  .cta-final h2 {
    max-width: 18ch;
    margin-bottom: var(--space-4);
    font-size: var(--step-4);
  }

  .cta-final__texto > :global(p) {
    max-width: var(--measure);
    margin-bottom: 0;
    font-size: var(--step-1);
  }

  .cta-final__texto > :global(:last-child) {
    margin-bottom: 0;
  }

  .cta-final .acoes {
    margin-top: 0;
  }
</style>
