---
/**
 * As duas frentes lado a lado, cada uma dizendo quem compra (spec 3.1 e 5.1). Textos [C] da
 * spec 3.1; os produtos vêm da navegação. Usado na Home e na página do Hugo.
 */
import navegacao from '../../data/navegacao.json';
import { empresa } from '../../lib/empresa';
import { url } from '../../lib/links';

interface Props {
  nivel?: 2 | 3;
}
const { nivel = 3 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
const [paraVoce, paraEmpresas] = navegacao.principal;
const frentes = [
  {
    item: paraVoce!,
    marca: empresa.marcas.pessoal.nome,
    quem: 'Quem compra é a pessoa.',
    lumi: false,
  },
  {
    item: paraEmpresas!,
    marca: empresa.marcas.empresas.nome,
    quem: 'Quem compra é a empresa. A Lumi fatura os contratos.',
    lumi: true,
  },
];
---

<div class="frentes">
  {frentes.map((f) => (
    <article class="frente superficie" data-brand={f.lumi ? 'lumi' : undefined}>
      <span class="eyebrow">{f.item.rotulo}</span>
      <Titulo class="frente__titulo">
        <a href={url(f.item.href)}>{f.marca}</a>
      </Titulo>
      <p class="frente__quem">{f.quem}</p>
      <ul class="frente__produtos">
        {f.item.filhos?.map((p) => (
          <li>
            <a href={url(p.href)}>{p.rotulo}</a>
          </li>
        ))}
      </ul>
    </article>
  ))}
</div>

<style>
  .frentes {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .frente {
    border-top: 3px solid var(--filete);
  }

  .frente__titulo {
    font-size: var(--step-2);
  }

  .frente__titulo a {
    color: var(--text-strong);
    text-decoration: none;
  }

  .frente__titulo a:hover {
    text-decoration: underline;
  }

  .frente__quem {
    font-size: var(--step-1);
    color: var(--text-strong);
  }

  .frente__produtos {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .frente__produtos li {
    border-bottom: 1px solid var(--line);
  }

  .frente__produtos a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding-block: var(--space-2);
  }
</style>
