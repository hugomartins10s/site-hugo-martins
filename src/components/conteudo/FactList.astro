---
// "Em resumo" (spec 5): 3 a 5 fatos. Com rótulo vira lista de definição; sem, lista simples.
// Item sem valor confirmado não deve ser passado: o componente não renderiza vazios.
interface Fato {
  rotulo?: string;
  valor: string;
}
interface Props {
  titulo?: string;
  fatos: Fato[];
  nivel?: 2 | 3;
}
const { titulo = 'Em resumo', fatos, nivel = 2 } = Astro.props;
const validos = fatos.filter((f) => f.valor?.trim());
const comRotulo = validos.every((f) => f.rotulo);
const Titulo = `h${nivel}` as 'h2' | 'h3';
---

{validos.length > 0 && (
  <section class="fatos superficie" aria-label={titulo}>
    <Titulo class="fatos__titulo eyebrow">{titulo}</Titulo>
    {comRotulo ? (
      <dl class="fatos__lista">
        {validos.map((f) => (
          <div class="fatos__item">
            <dt>{f.rotulo}</dt>
            <dd>{f.valor}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <ul class="fatos__lista">
        {validos.map((f) => (
          <li class="fatos__item">{f.valor}</li>
        ))}
      </ul>
    )}
  </section>
)}

<style>
  .fatos__titulo {
    font-size: var(--step--1);
  }

  .fatos__lista {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fatos__item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .fatos__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  @media (min-width: 40rem) {
    dl.fatos__lista .fatos__item {
      display: grid;
      grid-template-columns: 12rem 1fr;
      gap: var(--space-5);
    }
  }
</style>
