---
// Aviso cruzado entre as frentes (spec 5.5 e 5.6): onde mais se confunde quem compra.
//   para="empresas" → no Potencial Corporativo: "É uma empresa? Veja a Lumi"
//   para="pessoal"  → na seção Lumi: "Procura o trabalho individual? Veja Para você"
import { url } from '../../lib/links';

interface Props {
  para: 'empresas' | 'pessoal';
}
const { para } = Astro.props;
const aviso =
  para === 'empresas'
    ? { pergunta: 'É uma empresa?', link: 'Veja a Lumi', href: '/para-empresas/' }
    : { pergunta: 'Procura o trabalho individual?', link: 'Veja Para você', href: '/para-voce/' };
---

<aside class="cruzado superficie superficie--2" aria-label={aviso.pergunta}>
  <p>
    <strong>{aviso.pergunta}</strong>
    <a href={url(aviso.href)}>{aviso.link}</a>
  </p>
</aside>

<style>
  .cruzado p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: baseline;
    margin: 0;
    font-size: var(--step-1);
  }

  .cruzado a {
    font-weight: 600;
  }
</style>
