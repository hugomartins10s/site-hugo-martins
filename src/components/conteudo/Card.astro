---
// Cartão de conteúdo em superfície sólida (produto, post, conceito). O título é o link e a área
// clicável cobre o cartão inteiro.
interface Props {
  titulo: string;
  href: string;
  eyebrow?: string;
  meta?: string;
  nivel?: 2 | 3 | 4;
}
const { titulo, href, eyebrow, meta, nivel = 3 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3' | 'h4';
---

<article class="cartao superficie">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Titulo class="cartao__titulo">
    <a href={href}>{titulo}</a>
  </Titulo>
  <div class="cartao__texto">
    <slot />
  </div>
  <div class="cartao__pe">
    {meta && <p class="cartao__meta small muted">{meta}</p>}
    <span class="cartao__seta" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="16" height="16">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </span>
  </div>
</article>

<style>
  .cartao {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(var(--space-5), 2.4vw, var(--space-6));
    transition:
      transform var(--dur-2) var(--ease),
      box-shadow var(--dur-2) var(--ease);
  }

  .cartao:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra-2);
  }

  .cartao:active {
    transform: translateY(-1px);
  }

  .cartao__titulo {
    font-size: var(--step-2);
    line-height: 1.15;
    margin-bottom: var(--space-3);
  }

  .cartao__titulo a {
    color: var(--text-strong);
    text-decoration: none;
  }

  .cartao__titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .cartao__titulo a:focus-visible {
    outline: none;
  }

  .cartao:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .cartao__texto {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .cartao__texto :global(p:last-child) {
    margin-bottom: 0;
  }

  .cartao__pe {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-5);
  }

  .cartao__meta {
    margin: 0;
  }

  .cartao__seta {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    margin-left: auto;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--text-strong);
    transition:
      background var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }

  .cartao__seta svg {
    transition: transform var(--dur-2) var(--ease);
  }

  .cartao:hover .cartao__seta {
    background: var(--text-strong);
    border-color: var(--text-strong);
    color: var(--surface-1);
  }

  .cartao:hover .cartao__seta svg {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cartao:hover {
      transform: none;
    }
  }
</style>
