---
// Aviso legal (spec 5.9, texto fixo; revisão do Hugo em PENDENCIAS P22). Vai no rodapé
// (variante "rodape") e em toda página de produto da frente pessoal.
interface Props {
  variante?: 'pagina' | 'rodape';
}
const { variante = 'pagina' } = Astro.props;
const texto =
  'O trabalho de Hugo Martins é de desenvolvimento pessoal e profissional. Não é tratamento médico nem psicológico, não faz diagnóstico e não substitui o acompanhamento de profissionais de saúde.';
// No rodapé não é um landmark: aparece em toda página, e o "Aviso legal" da própria página
// (produtos da frente pessoal) já é o <aside>. Dois landmarks com o mesmo nome confundem.
---

{variante === 'pagina' ? (
  <aside class="aviso aviso--pagina superficie" aria-label="Aviso legal">
    <p>{texto}</p>
  </aside>
) : (
  <div class="aviso aviso--rodape">
    <p>{texto}</p>
  </div>
)}

<style>
  .aviso p {
    margin: 0;
  }

  .aviso--pagina {
    border-left: 3px solid var(--filete);
    max-width: var(--measure);
    margin-inline: auto;
  }

  .aviso--rodape {
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: var(--measure);
  }
</style>
