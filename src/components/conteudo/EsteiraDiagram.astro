---
/**
 * A esteira pessoal (spec 3.1 e 5.1): 10S → Potencial Humano ou Potencial Corporativo.
 * SVG com texto real (dois desenhos: largo e estreito) + descrição em texto com links, que é o
 * conteúdo acessível. Textos: regra da esteira da spec 3.1, palavra por palavra.
 */
import { url } from '../../lib/links';

interface Props {
  titulo?: string;
}
const { titulo } = Astro.props;
---

<figure class="esteira">
  {titulo && <h2 class="esteira__titulo">{titulo}</h2>}

  <svg class="esteira__svg esteira__svg--largo" viewBox="0 0 720 300" aria-hidden="true">
    <defs>
      <marker
        id="seta-l"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="8"
        markerHeight="8"
        orient="auto"
      >
        <path d="M0 0 10 5 0 10z" class="esteira__ponta"></path>
      </marker>
    </defs>
    <text x="20" y="72" class="esteira__rotulo">
      Sempre primeiro
    </text>
    <rect
      x="20"
      y="90"
      width="220"
      height="120"
      rx="22"
      class="esteira__caixa esteira__caixa--entrada"
    ></rect>
    <text x="130" y="145" text-anchor="middle" class="esteira__nome esteira__nome--grande">
      10S
    </text>
    <text x="130" y="180" text-anchor="middle" class="esteira__sub">
      10 sessões individuais
    </text>

    <path
      d="M240 150 C 320 150, 330 75, 452 75"
      class="esteira__linha"
      marker-end="url(#seta-l)"
    ></path>
    <path
      d="M240 150 C 320 150, 330 225, 452 225"
      class="esteira__linha"
      marker-end="url(#seta-l)"
    ></path>
    <text x="352" y="155" text-anchor="middle" class="esteira__rotulo esteira__rotulo--meio">
      em qualquer ordem
    </text>

    <rect x="460" y="20" width="240" height="110" rx="22" class="esteira__caixa"></rect>
    <text x="580" y="68" text-anchor="middle" class="esteira__nome">
      Potencial Humano
    </text>
    <text x="580" y="98" text-anchor="middle" class="esteira__sub">
      vida pessoal e social
    </text>

    <rect x="460" y="170" width="240" height="110" rx="22" class="esteira__caixa"></rect>
    <text x="580" y="218" text-anchor="middle" class="esteira__nome">
      Potencial Corporativo
    </text>
    <text x="580" y="248" text-anchor="middle" class="esteira__sub">
      vida de trabalho
    </text>
  </svg>

  <svg class="esteira__svg esteira__svg--estreito" viewBox="0 0 340 430" aria-hidden="true">
    <defs>
      <marker
        id="seta-e"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="8"
        markerHeight="8"
        orient="auto"
      >
        <path d="M0 0 10 5 0 10z" class="esteira__ponta"></path>
      </marker>
    </defs>
    <text x="170" y="22" text-anchor="middle" class="esteira__rotulo">
      Sempre primeiro
    </text>
    <rect
      x="70"
      y="36"
      width="200"
      height="110"
      rx="22"
      class="esteira__caixa esteira__caixa--entrada"
    ></rect>
    <text x="170" y="88" text-anchor="middle" class="esteira__nome esteira__nome--grande">
      10S
    </text>
    <text x="170" y="120" text-anchor="middle" class="esteira__sub">
      10 sessões individuais
    </text>

    <path
      d="M170 146 C 170 190, 85 190, 85 262"
      class="esteira__linha"
      marker-end="url(#seta-e)"
    ></path>
    <path
      d="M170 146 C 170 190, 255 190, 255 262"
      class="esteira__linha"
      marker-end="url(#seta-e)"
    ></path>
    <text x="170" y="222" text-anchor="middle" class="esteira__rotulo esteira__rotulo--meio">
      em qualquer ordem
    </text>

    <rect x="8" y="270" width="155" height="150" rx="20" class="esteira__caixa"></rect>
    <text x="85.5" y="322" text-anchor="middle" class="esteira__nome">
      <tspan x="85.5">Potencial</tspan>
      <tspan x="85.5" dy="26">
        Humano
      </tspan>
    </text>
    <text x="85.5" y="392" text-anchor="middle" class="esteira__sub">
      <tspan x="85.5">vida pessoal</tspan>
      <tspan x="85.5" dy="20">
        e social
      </tspan>
    </text>

    <rect x="177" y="270" width="155" height="150" rx="20" class="esteira__caixa"></rect>
    <text x="254.5" y="322" text-anchor="middle" class="esteira__nome">
      <tspan x="254.5">Potencial</tspan>
      <tspan x="254.5" dy="26">
        Corporativo
      </tspan>
    </text>
    <text x="254.5" y="392" text-anchor="middle" class="esteira__sub">
      <tspan x="254.5">vida de</tspan>
      <tspan x="254.5" dy="20">
        trabalho
      </tspan>
    </text>
  </svg>

  <figcaption class="esteira__descricao">
    O <a href={url('/para-voce/10s/')}>10S</a> vem sempre primeiro. Depois a pessoa escolhe
    <a href={url('/para-voce/potencial-humano/')}>Potencial Humano</a> ou
    <a href={url('/para-voce/potencial-corporativo/')}>Potencial Corporativo</a>, em qualquer ordem,
    e pode trocar no caminho.
  </figcaption>
</figure>

<style>
  .esteira {
    margin: 0;
  }

  .esteira__svg {
    width: 100%;
    max-width: 720px;
    height: auto;
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
  }

  .esteira__svg--estreito {
    display: none;
    max-width: 340px;
    margin-inline: auto;
  }

  @media (max-width: 35rem) {
    .esteira__svg--largo {
      display: none;
    }
    .esteira__svg--estreito {
      display: block;
    }
  }

  .esteira__caixa {
    fill: var(--surface-1);
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .esteira__caixa--entrada {
    stroke: var(--brand-1);
    stroke-width: 2;
  }

  .esteira__nome {
    fill: var(--text-strong);
    font-size: 21px;
    font-weight: 500;
  }

  .esteira__nome--grande {
    font-size: 40px;
  }

  .esteira__sub {
    fill: var(--text-muted);
    font-family: var(--font-body);
    font-size: 16px;
  }

  .esteira__rotulo {
    fill: var(--eyebrow);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .esteira__rotulo--meio {
    letter-spacing: 0.08em;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 6px;
  }

  .esteira__linha {
    fill: none;
    stroke: var(--brand-2);
    stroke-width: 2;
  }

  .esteira__ponta {
    fill: var(--brand-2);
  }

  /* A descrição em texto é o conteúdo acessível; no visual, o desenho já conta. Menos peso. */
  .esteira__descricao {
    max-width: var(--measure);
    margin-top: var(--space-4);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
</style>
