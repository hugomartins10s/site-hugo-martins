---
/**
 * SEO de cada página (spec 7.1): title, description (= resumo), robots, canonical absoluto,
 * Open Graph e Twitter Card. A imagem OG é gerada no build com o h1 da página
 * (src/lib/og/integracao.ts); o caminho dela sai da rota, então não precisa ser passado.
 */
import { HOMOLOGACAO } from 'astro:env/server';
import { empresa } from '../../lib/empresa';
import {
  arquivoOg,
  OG_ALTURA,
  OG_LARGURA,
  semBase,
  urlAbsolutaDoCaminho,
  urlInicio,
} from '../../lib/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** 404 não tem canonical (não é uma página que deva ser indexada em outro endereço). */
  canonical?: boolean;
  tipo?: 'website' | 'article';
  publicado?: string;
  atualizado?: string;
}

const {
  title,
  description,
  noindex = false,
  canonical = true,
  tipo = 'website',
  publicado,
  atualizado,
} = Astro.props;

const site = Astro.site;
const urlPagina = urlAbsolutaDoCaminho(Astro.url.pathname, site);
const imagem = new URL(arquivoOg(semBase(Astro.url.pathname)), urlInicio(site)).href;
const bloquear = HOMOLOGACAO || noindex;
---

<title>{title}</title>
<meta name="description" content={description} />
{bloquear && <meta name="robots" content="noindex, nofollow" />}
{canonical && <link rel="canonical" href={urlPagina} />}

<meta property="og:type" content={tipo} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={empresa.nome} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={urlPagina} />
<meta property="og:image" content={imagem} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_LARGURA)} />
<meta property="og:image:height" content={String(OG_ALTURA)} />
<meta property="og:image:alt" content={title} />
{publicado && <meta property="article:published_time" content={publicado} />}
{atualizado && <meta property="article:modified_time" content={atualizado} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imagem} />
