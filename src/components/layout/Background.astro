---
// Fundo do site (spec 9.1): navy com manchas de luz desfocadas e o PATTERN da marca em baixa
// opacidade, fixo. É o que dá algo para o vidro refratar. Decorativo.
import { url } from '../../lib/links';
---

<div class="fundo" aria-hidden="true" style={`--pattern: url(${url('/img/pattern.webp')})`}></div>

<style>
  .fundo {
    position: fixed;
    inset: 0;
    z-index: var(--z-bg);
    pointer-events: none;
    background:
      radial-gradient(ellipse 55vmax 42vmax at 10% 6%, var(--glow-1), transparent 70%),
      radial-gradient(ellipse 45vmax 38vmax at 92% 34%, var(--glow-2), transparent 70%),
      radial-gradient(ellipse 70vmax 45vmax at 40% 108%, var(--glow-3), transparent 70%), var(--bg);
  }

  .fundo::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--pattern);
    background-size: 270px;
    opacity: var(--pattern-opacity);
  }
</style>
