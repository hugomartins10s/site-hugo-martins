---
/**
 * Rodapé (spec 4.2): as duas frentes com seus produtos, Método, Blog, Livro, Imprensa, Contato,
 * redes, dados cadastrais (só quando confirmados: P03, P06), aviso legal resumido e
 * "Abraço de Alma". Superfície sólida navy, como o topo (D23); nada de vidro.
 */
import navegacao from '../../data/navegacao.json';
import { empresa, linkWhatsApp } from '../../lib/empresa';
import { url } from '../../lib/links';
import Disclaimer from '../conteudo/Disclaimer.astro';

const [paraVoce, paraEmpresas] = navegacao.principal;
const frentes = [
  { titulo: empresa.marcas.pessoal.nome, item: paraVoce },
  { titulo: empresa.marcas.empresas.nome, item: paraEmpresas },
];
const { endereco, cnpj, razaoSocial } = empresa;
const ano = new Date().getFullYear();
---

<footer class="rodape tema-navy navy-profundo">
  <div class="container rodape__grade">
    <div class="rodape__marca">
      <a href={url('/')}>
        <img
          src={url('/brand/hugo-martins-principal.webp')}
          width="640"
          height="328"
          alt={empresa.nome}
          loading="lazy"
        />
      </a>
      <p class="rodape__assinatura">{empresa.assinatura}</p>
    </div>

    {frentes.map(({ titulo, item }) => (
      <nav class="rodape__grupo" aria-label={`${item!.rotulo}: ${titulo}`}>
        <h2 class="rodape__titulo">
          <a href={url(item!.href)}>{item!.rotulo}</a>
        </h2>
        <ul>
          {item!.filhos?.map((f) => (
            <li>
              <a href={url(f.href)}>{f.rotulo}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <nav class="rodape__grupo" aria-label="Site">
      <h2 class="rodape__titulo">Site</h2>
      <ul>
        {navegacao.rodape.site.map((l) => (
          <li>
            <a href={url(l.href)}>{l.rotulo}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="rodape__grupo">
      <h2 class="rodape__titulo">Contato</h2>
      <address>
        <ul>
          <li>
            <a href={linkWhatsApp()} rel="noopener" target="_blank">
              WhatsApp {empresa.contato.whatsappExibicao}
            </a>
          </li>
          <li>
            <a href={`mailto:${empresa.contato.email}`}>{empresa.contato.email}</a>
          </li>
          {empresa.redes.map((r) => (
            <li>
              <a
                href={r.url}
                rel="noopener me"
                target="_blank"
                aria-label={`${r.rede} ${r.usuario}`}
              >
                {r.rede}
              </a>
            </li>
          ))}
        </ul>
      </address>
    </div>
  </div>

  <div class="container rodape__base">
    <Disclaimer variante="rodape" />
    <div class="rodape__legal">
      <p>
        © {ano} {empresa.nome}
        {razaoSocial && ` · ${razaoSocial}`}
        {cnpj && ` · CNPJ ${cnpj}`}
        {endereco &&
          ` · ${endereco.logradouro}, ${endereco.bairro}, ${endereco.cidade}/${endereco.uf}, CEP ${endereco.cep}`}
      </p>
      <ul>
        {navegacao.rodape.legal.map((l) => (
          <li>
            <a href={url(l.href)}>{l.rotulo}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Rodapé compacto (D56), na medida do site da Bespoke: marca e links numa linha só,
     texto 14px, e uma linha legal pequena embaixo. */
  .rodape {
    padding-block: var(--space-7) var(--space-5);
    border-top: 1px solid var(--line); /* separa do topo navy nas páginas curtas */
    font-size: 0.875rem;
  }

  /* no celular, espaço para o botão flutuante de WhatsApp não cobrir a linha legal */
  @media (max-width: 54rem) {
    .rodape {
      padding-bottom: calc(96px + env(safe-area-inset-bottom));
    }
  }

  /* No celular: um grupo por linha, links lado a lado (quebram quando precisa). */
  .rodape__grade {
    display: grid;
    gap: var(--space-5);
  }

  .rodape__grupo ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }

  /* No desktop: marca e grupos numa linha só, cada grupo em lista. */
  @media (min-width: 60rem) {
    .rodape__grade {
      grid-template-columns: minmax(10rem, 1.1fr) repeat(4, minmax(0, 1fr));
      gap: var(--space-6) var(--space-7);
    }

    .rodape__grupo ul {
      display: block;
    }
  }

  .rodape__marca img {
    width: 150px;
    height: auto;
  }

  .rodape__assinatura {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    color: var(--text-strong);
  }

  .rodape__titulo {
    margin: 0 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .rodape__titulo a {
    color: inherit;
    text-decoration: none;
  }

  .rodape__titulo a:hover {
    color: var(--creme);
  }

  .rodape ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rodape address {
    font-style: normal;
  }

  /* 14px com 5px de respiro: alvo de toque de 28px (WCAG 2.2 pede 24px). */
  .rodape__grupo li a {
    display: inline-block;
    padding-block: 5px;
    line-height: 1.3;
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .rodape__grupo li a:hover {
    color: var(--creme);
    text-decoration: underline;
    text-decoration-color: var(--hm-teal);
  }

  .rodape__base {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .rodape__base :global(.aviso) {
    font-size: 0.75rem;
  }

  /* tudo à esquerda: o botão flutuante de WhatsApp fica no canto direito e não cobre os links */
  .rodape__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-1) var(--space-5);
  }

  .rodape__legal p {
    margin: 0;
  }

  .rodape__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }

  .rodape__legal a {
    display: inline-block;
    padding-block: 6px;
    color: var(--text-muted);
  }
</style>
