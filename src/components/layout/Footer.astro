---
/**
 * Rodapé (spec 4.2): as duas frentes com seus produtos, Método, Blog, Livro, Imprensa, Contato,
 * redes, dados cadastrais (só quando confirmados: P03, P06), aviso legal resumido e
 * "Abraço de Alma". Superfície sólida navy, como o topo (D23); nada de vidro.
 */
import navegacao from '../../data/navegacao.json';
import { empresa, linkWhatsApp } from '../../lib/empresa';
import { url } from '../../lib/links';
import Disclaimer from '../conteudo/Disclaimer.astro';

const [paraVoce, paraEmpresas] = navegacao.principal;
const frentes = [
  { titulo: empresa.marcas.pessoal.nome, item: paraVoce },
  { titulo: empresa.marcas.empresas.nome, item: paraEmpresas },
];
const { endereco, cnpj, razaoSocial } = empresa;
const temCadastro = Boolean(endereco || cnpj || razaoSocial);
const ano = new Date().getFullYear();
---

<footer class="rodape tema-navy">
  <div class="container">
    <div class="rodape__topo">
      <a class="rodape__marca" href={url('/')}>
        <img
          src={url('/brand/hugo-martins-principal.webp')}
          width="640"
          height="328"
          alt={empresa.nome}
          loading="lazy"
        />
      </a>
      <p class="rodape__assinatura">{empresa.assinatura}</p>
    </div>

    <div class="rodape__colunas">
      {frentes.map(({ titulo, item }) => (
        <nav class="rodape__grupo" aria-label={`${item!.rotulo}: ${titulo}`}>
          <h2 class="rodape__titulo">
            <a href={url(item!.href)}>{item!.rotulo}</a>
          </h2>
          <p class="rodape__sub">{titulo}</p>
          <ul>
            {item!.filhos?.map((f) => (
              <li>
                <a href={url(f.href)}>{f.rotulo}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <nav class="rodape__grupo" aria-label="Site">
        <h2 class="rodape__titulo">Site</h2>
        <ul>
          {navegacao.rodape.site.map((l) => (
            <li>
              <a href={url(l.href)}>{l.rotulo}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="rodape__grupo">
        <h2 class="rodape__titulo">Contato</h2>
        <address>
          <ul>
            <li>
              <a href={linkWhatsApp()} rel="noopener" target="_blank">
                WhatsApp {empresa.contato.whatsappExibicao}
              </a>
            </li>
            <li>
              <a href={`mailto:${empresa.contato.email}`}>{empresa.contato.email}</a>
            </li>
            {empresa.redes.map((r) => (
              <li>
                <a href={r.url} rel="noopener me" target="_blank">
                  {r.rede} {r.usuario}
                </a>
              </li>
            ))}
          </ul>
        </address>
      </div>
    </div>

    <div class="rodape__base">
      <Disclaimer variante="rodape" />
      {temCadastro && (
        <p class="rodape__cadastro">
          {razaoSocial}
          {cnpj && ` · CNPJ ${cnpj}`}
          {endereco &&
            ` · ${endereco.logradouro}, ${endereco.bairro}, ${endereco.cidade}/${endereco.uf}, CEP ${endereco.cep}`}
        </p>
      )}
      <div class="rodape__legal">
        <p>
          © {ano} {empresa.nome}
        </p>
        <ul>
          {navegacao.rodape.legal.map((l) => (
            <li>
              <a href={url(l.href)}>{l.rotulo}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .rodape {
    /* embaixo, espaço para o botão flutuante de WhatsApp não cobrir os links legais */
    padding-block: var(--space-8) calc(var(--space-6) + 76px);
    border-top: 1px solid var(--line); /* separa do topo navy nas páginas curtas */
    background: var(--bg);
    font-size: var(--step--1);
  }

  .rodape__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--line);
  }

  .rodape__marca img {
    width: 180px;
  }

  .rodape__assinatura {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--text-strong);
  }

  .rodape__colunas {
    display: grid;
    gap: var(--space-7) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    padding-block: var(--space-7);
  }

  .rodape__titulo {
    margin-bottom: var(--space-2);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .rodape__titulo a {
    color: inherit;
  }

  .rodape__sub {
    margin-bottom: var(--space-2);
    color: var(--text-muted);
  }

  .rodape ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rodape address {
    font-style: normal;
  }

  .rodape__grupo li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
    text-decoration: none;
  }

  .rodape__grupo li a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  .rodape__base {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    color: var(--text-muted);
  }

  .rodape__base :global(.aviso p) {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .rodape__cadastro {
    margin: 0;
  }

  .rodape__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }

  .rodape__legal p {
    margin: 0;
  }

  .rodape__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }

  .rodape__legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text-muted);
  }
</style>
