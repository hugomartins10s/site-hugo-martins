---
// Topo navy de cada página (direção "Misto", D23): trilha, título, parágrafo-resposta e ações.
// Fica atrás do cabeçalho flutuante e usa as cores do contexto navy. O resto da página é claro.
// A trilha é a mesma passada ao Base (que gera o BreadcrumbList do JSON-LD).
import type { ItemTrilha } from '../../lib/schema/grafo';
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  trilha?: ItemTrilha[];
  class?: string;
}
const { trilha, class: extra } = Astro.props;
---

<div class:list={['topo', 'tema-navy', 'navy-profundo', extra]}>
  <div class="container topo__conteudo">
    {trilha && <Breadcrumb itens={trilha} />}
    <slot />
  </div>
</div>

<style>
  .topo {
    padding-top: calc(var(--topo-livre) + var(--space-5));
    padding-bottom: clamp(var(--space-7), 4vw, var(--space-8));
  }

  .topo__conteudo > :global(h1:not(.display)) {
    max-width: 30ch;
  }

  /* O parágrafo-resposta continua inteiro no HTML (spec 5), mas com menos peso que o título:
     corpo um pouco maior que o texto, cor secundária (D51). */
  .topo__conteudo > :global(.lead) {
    max-width: 58ch;
    margin-top: var(--space-5);
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .topo__conteudo > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
