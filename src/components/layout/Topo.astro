---
// Topo navy de cada página (direção "Misto", D23): trilha, título, parágrafo-resposta e ações.
// Fica atrás do cabeçalho flutuante e usa as cores do contexto navy. O resto da página é claro.
// A trilha é a mesma passada ao Base (que gera o BreadcrumbList do JSON-LD).
import type { ItemTrilha } from '../../lib/schema/grafo';
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  trilha?: ItemTrilha[];
  class?: string;
  /** Centro (padrão, D63): o topo só tem texto e fica no eixo da página. Esquerda: quando há
   * imagem ao lado (Home, livro). */
  alinhamento?: 'centro' | 'esquerda';
}
const { trilha, class: extra, alinhamento = 'centro' } = Astro.props;
---

<div
  class:list={[
    'topo',
    'tema-navy',
    'navy-profundo',
    { 'topo--centro': alinhamento === 'centro' },
    extra,
  ]}
>
  <div class="container topo__conteudo">
    {trilha && <Breadcrumb itens={trilha} />}
    <slot />
  </div>
</div>

<style>
  .topo {
    padding-top: calc(var(--topo-livre) + var(--space-5));
    padding-bottom: clamp(var(--space-7), 4vw, var(--space-8));
  }

  .topo__conteudo > :global(h1:not(.display)) {
    max-width: 30ch;
  }

  /* O parágrafo-resposta continua inteiro no HTML (spec 5), mas com menos peso que o título:
     corpo um pouco maior que o texto, cor secundária (D51). */
  .topo__conteudo > :global(.lead) {
    max-width: 58ch;
    margin-top: var(--space-5);
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  /* Topo centralizado (D63): título, parágrafo, trilha, rótulo e botões no eixo da página. */
  .topo--centro .topo__conteudo {
    text-align: center;
  }

  .topo--centro .topo__conteudo > :global(*) {
    margin-inline: auto;
  }

  .topo--centro .topo__conteudo > :global(.eyebrow),
  .topo--centro .topo__conteudo > :global(.acoes),
  .topo--centro .topo__conteudo :global(.trilha ol) {
    justify-content: center;
  }

  .topo__conteudo > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
