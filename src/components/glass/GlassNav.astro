---
/**
 * Cabeçalho flutuante em pílula de vidro (spec 4.2, 9.1, 9.3).
 *
 * - Funciona sem JS: os submenus e o menu do celular são <details>. O JS só abre os submenus no
 *   hover (mouse), deixa um aberto por vez e fecha com Esc e com clique fora.
 * - "Para você" e "Para empresas" abrem um painel com a frente (quem compra), a visão geral e os
 *   três produtos. Os textos são os [C] da spec 3.1 (lib/frentes.ts).
 * - O vidro fica numa camada própria (.nav__vidro), não no <header>: um elemento com
 *   backdrop-filter isolaria o backdrop dos filhos e os painéis de vidro perderiam o efeito.
 * - Liquid Glass fosco e transparente (D50): escuro sobre as áreas navy, claro sobre o papel. Quem
 *   alterna é o script de Base.astro ([data-vidro-auto]); sem JS fica o vidro navy quase opaco.
 * - É a moldura do site inteiro: usa sempre as fontes e cores Hugo Martins, também nas páginas
 *   da Lumi (onde a marca Lumi aparece só no painel "Para empresas", com o logo dela).
 */
import navegacao from '../../data/navegacao.json';
import { empresa, linkWhatsApp } from '../../lib/empresa';
import { frenteDoItem } from '../../lib/frentes';
import { url } from '../../lib/links';
import GlassButton from './GlassButton.astro';
import WhatsApp from '../icones/WhatsApp.astro';

const atual = Astro.url.pathname;
const ativo = (href: string) => atual === url(href) || atual.startsWith(url(href));
---

<header class="nav tema-navy" data-nav data-vidro-auto>
  <div class="nav__barra" data-vidro-medida>
    <div class="nav__vidro vidro glass--lente" aria-hidden="true"></div>

    <a class="nav__marca" href={url('/')}>
      <img
        class="nav__logo nav__logo--navy"
        src={url('/brand/hugo-martins-horizontal.webp')}
        width="480"
        height="81"
        alt={empresa.nome}
        fetchpriority="high"
      />
      <img
        class="nav__logo nav__logo--claro"
        src={url('/brand/hugo-martins-horizontal-preto.webp')}
        width="480"
        height="81"
        alt={empresa.nome}
      />
      <img
        class="nav__logo-compacto"
        src={url('/brand/hugo-martins-submarca.webp')}
        width="160"
        height="183"
        alt={empresa.nome}
      />
    </a>

    <nav class="nav__principal" aria-label="Principal">
      <ul class="nav__lista">
        {navegacao.principal.map((item) => {
          const frente = frenteDoItem(item.href);
          return (
            <li class="nav__item">
              {item.filhos ? (
                <details class="nav__sub" data-nav-details data-nav-hover>
                  <summary class:list={['nav__link', ativo(item.href) && 'nav__link--ativo']}>
                    {item.rotulo}
                    <svg aria-hidden="true" viewBox="0 0 12 12" width="12" height="12">
                      <path
                        d="M2.5 4.5 6 8 9.5 4.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </summary>
                  <div class="nav__painel vidro vidro--painel">
                    <div class="nav__painel-frente">
                      {frente?.lumi ? (
                        <>
                          <img
                            class="nav__painel-lumi nav__logo--navy"
                            src={url('/brand/lumi-branco.svg')}
                            width="2777"
                            height="979"
                            alt={frente.marca}
                            loading="lazy"
                          />
                          <img
                            class="nav__painel-lumi nav__logo--claro"
                            src={url('/brand/lumi.svg')}
                            width="2777"
                            height="979"
                            alt={frente.marca}
                            loading="lazy"
                          />
                        </>
                      ) : (
                        <p class="nav__painel-marca">{frente?.marca}</p>
                      )}
                      <p class="nav__painel-quem">{frente?.quem}</p>
                      <a
                        class="link-seta nav__painel-geral"
                        href={url(item.href)}
                        aria-current={atual === url(item.href) ? 'page' : undefined}
                      >
                        Visão geral
                      </a>
                    </div>
                    <ul class="nav__painel-lista">
                      {item.filhos.map((filho) => (
                        <li>
                          <a
                            href={url(filho.href)}
                            aria-current={atual === url(filho.href) ? 'page' : undefined}
                          >
                            {filho.rotulo}
                            <span aria-hidden="true">→</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              ) : (
                <a
                  class:list={['nav__link', ativo(item.href) && 'nav__link--ativo']}
                  href={url(item.href)}
                  aria-current={atual === url(item.href) ? 'page' : undefined}
                >
                  {item.rotulo}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <GlassButton href={url(navegacao.cta.href)} class="nav__cta">
      {navegacao.cta.rotulo}
    </GlassButton>

    <details class="nav__movel" data-nav-details>
      <summary class="btn glass nav__menu">
        <span class="nav__menu-icone" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
        <span class="nav__menu-abrir">Menu</span>
        <span class="nav__menu-fechar">Fechar</span>
      </summary>
      <nav class="nav__folha vidro vidro--painel vidro--denso" aria-label="Principal (celular)">
        <ul class="nav__folha-lista">
          {navegacao.principal.map((item) => {
            const frente = frenteDoItem(item.href);
            return (
              <li class:list={[item.filhos && 'nav__folha-grupo']}>
                <a
                  class="nav__folha-link"
                  href={url(item.href)}
                  aria-current={atual === url(item.href) ? 'page' : undefined}
                >
                  {item.rotulo}
                </a>
                {frente && <p class="nav__folha-quem">{frente.quem}</p>}
                {item.filhos && (
                  <ul class="nav__folha-filhos">
                    {item.filhos.map((filho) => (
                      <li>
                        <a
                          href={url(filho.href)}
                          aria-current={atual === url(filho.href) ? 'page' : undefined}
                        >
                          {filho.rotulo}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
        <div class="nav__folha-acoes">
          <GlassButton href={url(navegacao.cta.href)} tamanho="grande">
            {navegacao.cta.rotulo}
          </GlassButton>
          <GlassButton
            href={linkWhatsApp()}
            variante="secundario"
            tamanho="grande"
            rel="noopener"
            target="_blank"
          >
            <WhatsApp tamanho={20} />
            WhatsApp
          </GlassButton>
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  // Aprimoramento: abre no hover (só com mouse), um painel por vez; Esc e clique fora fecham.
  const cabecalho = document.querySelector<HTMLElement>('[data-nav]');
  if (cabecalho) {
    const todos = [...cabecalho.querySelectorAll<HTMLDetailsElement>('[data-nav-details]')];
    const fechar = (exceto?: HTMLDetailsElement) =>
      todos.forEach((d) => d !== exceto && d.removeAttribute('open'));

    todos.forEach((d) => d.addEventListener('toggle', () => d.open && fechar(d)));

    const mouse = matchMedia('(hover: hover) and (pointer: fine)');
    cabecalho.querySelectorAll<HTMLDetailsElement>('[data-nav-hover]').forEach((d) => {
      let timer: number | undefined;
      const item = d.closest('li')!;
      item.addEventListener('pointerenter', () => {
        if (!mouse.matches) return;
        clearTimeout(timer);
        d.open = true;
      });
      item.addEventListener('pointerleave', () => {
        if (!mouse.matches) return;
        timer = window.setTimeout(() => d.removeAttribute('open'), 160);
      });
      // Com mouse, o hover já abriu: o clique no rótulo não pode fechar o painel.
      d.querySelector('summary')!.addEventListener('click', (e) => {
        if (!mouse.matches || (e as PointerEvent).pointerType !== 'mouse') return;
        e.preventDefault();
        d.open = true;
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const aberto = todos.find((d) => d.open);
      if (aberto) {
        aberto.removeAttribute('open');
        aberto.querySelector('summary')?.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Node)) return;
      todos.forEach((d) => d.open && !d.contains(e.target as Node) && d.removeAttribute('open'));
    });
  }
</script>

<style>
  /* Moldura Hugo Martins em qualquer página (inclusive Lumi): fontes e cores do Hugo nos dois
     modos do vidro. Escuro (sobre navy): botão creme. Claro (sobre papel): botão navy. */
  :root .nav {
    --font-display: 'Source Serif 4', 'Iowan Old Style', Georgia, serif;
    --font-body: 'Source Sans 3', 'Segoe UI', system-ui, -apple-system, sans-serif;
    --font-ui: var(--font-body);
    --link: var(--hm-navy);
    --link-hover: var(--teal-escuro);
    --focus: var(--hm-navy);
    --eyebrow: var(--hm-navy); /* teal escuro não tem contraste sobre o vidro claro */
    --tint-bg: linear-gradient(135deg, rgba(14, 20, 60, 0.92), rgba(0, 5, 35, 0.88));
    --tint-bg-hover: linear-gradient(135deg, rgba(26, 34, 82, 0.94), rgba(0, 5, 35, 0.9));
    --tint-text: #ffffff;
    --tint-border: rgba(0, 5, 35, 0.6);
    --tint-opaco: var(--hm-navy);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  :root .nav.tema-navy {
    --link: var(--hm-teal);
    --link-hover: var(--hm-cyan);
    --focus: var(--hm-cyan);
    --eyebrow: var(--hm-teal);
    --tint-bg: linear-gradient(135deg, rgba(243, 240, 232, 0.96), rgba(243, 240, 232, 0.88));
    --tint-bg-hover: linear-gradient(135deg, #fff, rgba(243, 240, 232, 0.94));
    --tint-text: var(--hm-navy);
    --tint-border: rgba(255, 255, 255, 0.5);
    --tint-opaco: var(--creme);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .nav {
    position: fixed;
    inset: max(var(--space-3), env(safe-area-inset-top)) 0 auto;
    z-index: var(--z-nav);
    pointer-events: none;
  }

  .nav__barra {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    width: min(100% - 2 * var(--space-3), var(--container) + 2rem);
    min-height: 64px;
    margin-inline: auto;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    color: var(--text-strong);
    pointer-events: auto;
  }

  .nav__vidro {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--radius-pill);
  }

  .nav__marca {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--tap);
    border-radius: var(--radius-inner);
  }

  .nav__logo {
    width: 212px;
    height: auto;
  }

  /* Logo colorido sobre o vidro escuro; versão preta oficial sobre o vidro claro. */
  .nav__logo--claro,
  .nav.tema-navy .nav__logo--claro {
    display: none;
  }

  .nav:not(.tema-navy) .nav__logo--navy {
    display: none;
  }

  .nav:not(.tema-navy) .nav__logo--claro {
    display: block;
  }

  .nav__logo-compacto {
    display: none;
    width: 34px;
    height: auto;
  }

  .nav__principal {
    margin-inline: auto;
  }

  .nav__lista {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    padding-inline: 14px;
    border-radius: var(--radius-pill);
    color: var(--text);
    font-size: 0.97rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
    transition:
      color var(--dur-1) var(--ease),
      background var(--dur-1) var(--ease);
  }

  .nav__link::-webkit-details-marker {
    display: none;
  }

  .nav__link:hover,
  .nav__sub[open] > .nav__link {
    color: var(--text-strong);
    background: color-mix(in srgb, var(--text-strong) 8%, transparent);
    text-decoration: none;
  }

  .nav__link svg {
    opacity: 0.7;
    transition: transform var(--dur-2) var(--ease);
  }

  .nav__sub[open] > .nav__link svg {
    transform: rotate(180deg);
  }

  /* Seção atual: texto cheio e um ponto teal embaixo. */
  .nav__link--ativo {
    color: var(--text-strong);
  }

  .nav__link--ativo::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 5px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--eyebrow);
    transform: translateX(-50%);
  }

  .nav__sub > .nav__link--ativo::after {
    left: calc(50% - 9px);
  }

  /* ---------- Painel das frentes ---------- */

  .nav__painel {
    position: absolute;
    top: calc(100% + 18px);
    left: -1rem;
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 1fr);
    gap: var(--space-2);
    width: 38rem;
    padding: var(--space-3);
    animation: painel-entra var(--dur-2) var(--ease);
  }

  /* Ponte invisível entre o link e o painel: o hover não cai no vão. */
  .nav__painel::before {
    content: '';
    position: absolute;
    inset: -20px 0 100%;
  }

  @keyframes painel-entra {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .nav__painel-frente {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border-radius: 16px;
    background: color-mix(in srgb, var(--text-strong) 5%, transparent);
  }

  .nav__painel-marca {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--text-strong);
  }

  .nav__painel-lumi {
    width: 120px;
    height: auto;
    margin-bottom: var(--space-3);
  }

  .nav__painel-quem {
    margin: 0 0 var(--space-4);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .nav__painel-geral {
    margin-top: auto;
    min-height: 32px;
    font-size: 0.9375rem;
    color: var(--text-strong);
  }

  .nav__painel-geral::after {
    color: var(--eyebrow);
  }

  .nav__painel-geral:hover {
    color: var(--text-strong);
  }

  .nav__painel-lista {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__painel-lista a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding: var(--space-2) var(--space-4);
    border-radius: 14px;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.25;
    color: var(--text-strong);
    text-decoration: none;
    transition: background var(--dur-1) var(--ease);
  }

  .nav__painel-lista li + li a {
    box-shadow: 0 -1px 0 var(--line);
  }

  .nav__painel-lista span {
    flex: none;
    font-family: var(--font-ui);
    color: var(--eyebrow);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease);
  }

  .nav__painel-lista a:hover,
  .nav__painel-lista a[aria-current='page'] {
    background: color-mix(in srgb, var(--text-strong) 8%, transparent);
    box-shadow: none;
  }

  .nav__painel-lista a:hover span,
  .nav__painel-lista a:focus-visible span,
  .nav__painel-lista a[aria-current='page'] span {
    opacity: 1;
    transform: none;
  }

  .nav :global(.nav__cta) {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav__movel {
    display: none;
  }

  /* ---------- Celular e tablet ---------- */

  @media (max-width: 67.99rem) {
    .nav__barra {
      gap: var(--space-3);
      padding-left: var(--space-4);
    }

    .nav__principal,
    .nav :global(.nav__cta) {
      display: none;
    }

    .nav__movel {
      display: block;
      margin-left: auto;
    }

    .nav__menu {
      gap: 10px;
      padding-inline: 1.1rem 1.25rem;
      list-style: none;
    }

    .nav__menu::-webkit-details-marker {
      display: none;
    }

    .nav__menu-icone {
      display: grid;
      gap: 5px;
      width: 18px;
    }

    .nav__menu-icone span {
      display: block;
      height: 1.5px;
      border-radius: 2px;
      background: currentColor;
      transition: transform var(--dur-2) var(--ease);
    }

    .nav__movel[open] .nav__menu-icone span:first-child {
      transform: translateY(3.25px) rotate(45deg);
    }

    .nav__movel[open] .nav__menu-icone span:last-child {
      transform: translateY(-3.25px) rotate(-45deg);
    }

    .nav__menu-fechar,
    .nav__movel[open] .nav__menu-abrir {
      display: none;
    }

    .nav__movel[open] .nav__menu-fechar {
      display: inline;
    }

    .nav__folha {
      position: absolute;
      top: calc(100% + var(--space-2));
      left: 0;
      right: 0;
      max-height: calc(100dvh - 6.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-5) var(--space-5) var(--space-5);
      animation: painel-entra var(--dur-2) var(--ease);
    }

    .nav__folha ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .nav__folha-lista > li {
      border-bottom: 1px solid var(--line);
    }

    .nav__folha-grupo {
      padding-bottom: var(--space-4);
    }

    .nav__folha-link {
      display: flex;
      align-items: center;
      min-height: 56px;
      font-family: var(--font-display);
      font-size: 1.5rem;
      color: var(--text-strong);
      text-decoration: none;
    }

    .nav__folha-link[aria-current='page'] {
      color: var(--eyebrow);
    }

    .nav__folha-quem {
      margin: calc(-1 * var(--space-2)) 0 var(--space-2);
      font-size: 0.9375rem;
      color: var(--text-muted);
    }

    .nav__folha-filhos a {
      display: flex;
      align-items: center;
      min-height: var(--tap);
      padding-left: var(--space-4);
      border-left: 1px solid var(--line-strong);
      color: var(--text);
      text-decoration: none;
    }

    .nav__folha-filhos a:hover,
    .nav__folha-filhos a[aria-current='page'] {
      border-left-color: var(--eyebrow);
      color: var(--text-strong);
    }

    :global(html:has(.nav__movel[open])) {
      overflow: hidden;
    }

    .nav__folha-acoes {
      display: grid;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }
  }

  @media (max-width: 30rem) {
    .nav__logo {
      width: 176px;
    }
  }

  @media (max-width: 22rem) {
    .nav .nav__logo,
    .nav:not(.tema-navy) .nav__logo--claro {
      display: none;
    }
    .nav__logo-compacto {
      display: block;
    }
  }
</style>
