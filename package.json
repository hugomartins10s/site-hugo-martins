{
  "name": "site-hugo-martins",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Site institucional Hugo Martins – Desenvolvimento de Potencial Humano",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "check:pendentes": "node scripts/check-pendentes.mjs src/content src/data",
    "check:pendentes:dist": "node scripts/check-pendentes.mjs dist",
    "prebuild": "npm run check:pendentes",
    "build": "astro build",
    "postbuild": "npm run check:pendentes:dist",
    "build:homologacao": "HOMOLOGACAO=true astro build && node scripts/check-pendentes.mjs --aviso dist",
    "lint": "astro check && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
